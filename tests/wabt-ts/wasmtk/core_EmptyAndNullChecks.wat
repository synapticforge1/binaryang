        (i32.store (i32.const 0) (if (result i32) (call $isStringNull (i32.const 270) (i32.const 5)) (then (i32.const 260)) (else (i32.const 264))))
          (i32.store (i32.const 4) (if (result i32) (call $isStringNull (i32.const 270) (i32.const 5)) (then (i32.const 4)) (else (i32.const 5))))
          (i32.store (i32.const 8) (i32.const 269))
          (i32.store (i32.const 12) (i32.const 1))
          (drop (call $fd_write
            (i32.const 1)
