{
  "minimumDependencyAge": "0",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/expect": "jsr:@std/expect@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/fs": "jsr:@std/fs@^1.0.0"
  },
  "workspace": [
    "./tests/binaryen-ts",
    "./scripts/binaryen-ts",
    "./comparison"
  ],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "lib": [
      "esnext",
      "deno.ns",
      "deno.window",
      "dom"
    ]
  },
  "tasks": {
    "check": "deno check src/**/*.ts main.ts tests/**/*.ts scripts/**/*.ts",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env tests/binaryen-ts/ tests/wabt-ts/ tests/ir/ tests/definitions/",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "ci": "deno task check && deno task test",
    "publish:dry": "deno publish --dry-run --allow-dirty --config jsr.json",
    "naming": "deno run --allow-run scripts/check-naming.ts",
    "portability": "deno run --allow-run --allow-read scripts/check-portability.ts",
    "collisions": "deno run --allow-read scripts/count-collisions.ts",
    "offsets": "deno run --allow-read scripts/measure-diagnostic-offsets.ts",
    "diagnostics": "deno run --allow-read scripts/measure-diagnostics.ts",
    "bump": "deno run --allow-read --allow-write scripts/release/bump_version.ts",
    "release": "deno run --allow-read --allow-write --allow-run scripts/release/publish.ts",
    "baseline": "deno run --allow-read scripts/wabt-ts/verify-baseline.ts",
    "operators": "deno run --allow-read scripts/check-operator-mapping.ts",
    "spec:prepare": "deno run --allow-read --allow-write --allow-run --allow-env scripts/spec-prepare.ts",
    "spec": "deno run --allow-read --allow-write --allow-env scripts/spec-testsuite.ts",
    "direct": "deno run --allow-read scripts/check-direct-corpus.ts",
    "direct-behaviour": "deno run --allow-read scripts/check-direct-behaviour.ts",
    "translate-eh": "deno run --allow-read --allow-write --allow-run --allow-env scripts/check-translate-eh.ts",
    "optimize-corpus": "deno run --allow-read scripts/check-optimize-corpus.ts",
    "spec-behaviour": "deno run --allow-read scripts/check-spec-behaviour.ts",
    "interp": "deno run --allow-read scripts/check-interp.ts",
    "hostile": "deno run --allow-read scripts/check-hostile.ts",
    "proposals": "deno run --allow-read --allow-run --allow-env scripts/check-proposals.ts",
    "definitions": "deno run --allow-read --allow-write --allow-run scripts/definitions.ts",
    "comparison": "deno check comparison/ && deno test --allow-read --allow-write --allow-run --allow-env --allow-net comparison/tests/*.compare.ts"
  },
  "fmt": {
    "include": [
      "src/",
      "tests/",
      "scripts/",
      "main.ts",
      "benches/"
    ],
    "exclude": [
      "scripts/**/*.md",
      "tests/wabt-ts/wasmtk/"
    ],
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true
  },
  "lint": {
    "include": [
      "src/",
      "tests/",
      "scripts/",
      "main.ts"
    ],
    "exclude": [
      "tests/wabt-ts/wasmtk/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "exclude": [
    "node_modules/",
    "dist/"
  ]
}
