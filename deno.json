{
  "name": "@jrmarcum/wabt-ts",
  "version": "1.1.3",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./wat2wasm": "./src/tools/wat2wasm.ts",
    "./wasm2wat": "./src/tools/wasm2wat.ts",
    "./wasm-validate": "./src/tools/wasm-validate.ts",
    "./wasm-objdump": "./src/tools/wasm-objdump.ts",
    "./wasm-strip": "./src/tools/wasm-strip.ts",
    "./wasm2ts": "./src/tools/wasm2ts.ts"
  },

  "tasks": {
    "check": "deno check src/**/*.ts tests/**/*.ts",
    "test": "deno test --allow-read tests/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "bump": "deno run --allow-read --allow-write scripts/bump_version.ts",
    "publish": "deno run --allow-read --allow-run scripts/publish.ts",
    "publish:dry": "deno publish --dry-run --allow-dirty",
    "ci": "deno task check && deno task test"
  },

  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/expect": "jsr:@std/expect@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.0",
    "@jrmarcum/binaryen-ts/ir": "jsr:@jrmarcum/binaryen-ts@^1.0.9/ir",
    "@jrmarcum/binaryen-ts/encoder": "jsr:@jrmarcum/binaryen-ts@^1.0.9/encoder"
  },

  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2022", "deno.ns", "deno.window"]
  },

  "lint": {
    "include": ["src/", "tests/"],
    "rules": {
      "tags": ["recommended"]
    }
  },

  "fmt": {
    "include": ["src/", "tests/"],
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true
  },

  "exclude": ["upstream/", "binaryen-ts/", "wasmtk/", "dist/", "node_modules/"],

  "publish": {
    "include": [
      "src/**/*.ts",
      "LICENSE",
      "LICENSE-MIT",
      "LICENSE-APACHE",
      "NOTICE.md",
      "README.md",
      "deno.json"
    ],
    "exclude": [
      "src/**/*.test.ts",
      "tests/"
    ]
  }
}
