{
  "minimumDependencyAge": "0",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/expect": "jsr:@std/expect@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/fs": "jsr:@std/fs@^1.0.0"
  },
  "workspace": [
    "./tests/binaryen-ts",
    "./scripts/binaryen-ts",
    "./comparison"
  ],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "lib": [
      "esnext",
      "deno.ns",
      "deno.window",
      "dom"
    ],
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false
  },
  "tasks": {
    "check": "deno check src/**/*.ts main.ts tests/**/*.ts scripts/**/*.ts",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env tests/binaryen-ts/ tests/wabt-ts/ tests/ir/ tests/definitions/",
    "ci": "deno task check && deno task test",
    "publish:dry": "deno publish --dry-run --allow-dirty --config jsr.json",
    "comparison": "deno check comparison/ && deno test --allow-read --allow-write --allow-run --allow-env --allow-net comparison/tests/*.compare.ts"
  },
  "fmt": {
    "include": [
      "src/",
      "tests/",
      "scripts/",
      "main.ts",
      "benches/"
    ],
    "exclude": [
      "scripts/**/*.md",
      "tests/wabt-ts/wasmtk/"
    ],
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true
  },
  "exclude": [
    "node_modules/",
    "dist/"
  ]
}
