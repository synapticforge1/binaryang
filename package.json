{
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun check -p tsconfig.json && bun check -p scripts/binaryen-ts/tsconfig.json && bun check -p tests/tsconfig.json && bun check -p tests/binaryen-ts/tsconfig.json && bun check -p examples/browser-optimize/tsconfig.json",
    "check:tsc": "tsc -p tsconfig.json && tsc -p scripts/binaryen-ts/tsconfig.json && tsc -p tests/tsconfig.json && tsc -p tests/binaryen-ts/tsconfig.json && tsc -p examples/browser-optimize/tsconfig.json",
    "test": "bun scripts/test.ts",
    "test:bun": "bun scripts/test.ts --bun",
    "naming": "bun scripts/check-naming.ts",
    "portability": "bun scripts/check-portability.ts",
    "collisions": "bun scripts/count-collisions.ts",
    "diagnostics": "bun scripts/measure-diagnostics.ts",
    "bump": "bun scripts/release/bump_version.ts",
    "surface": "bun scripts/release/api-surface.ts",
    "surface:check": "bun scripts/release/api-surface.ts --check",
    "surface:floor": "bun scripts/release/api-surface.ts --floor",
    "release": "bun scripts/release/publish.ts",
    "npm:build": "bun scripts/npm/build.ts",
    "npm:prove": "bun scripts/npm/prove.ts",
    "baseline": "bun scripts/wabt-ts/verify-baseline.ts",
    "operators": "bun scripts/check-operator-mapping.ts",
    "spec:prepare": "bun scripts/spec-prepare.ts",
    "spec": "bun scripts/spec-testsuite.ts",
    "interp": "bun scripts/check-interp.ts",
    "proposals": "bun scripts/check-proposals.ts",
    "definitions": "bun scripts/definitions.ts",
    "spec-opcodes": "bun scripts/spec-opcodes.ts",
    "probe": "bun scripts/probe/portability.ts",
    "offsets": "bun scripts/v8.ts scripts/measure-diagnostic-offsets.ts",
    "direct": "bun scripts/v8.ts scripts/check-direct-corpus.ts",
    "direct-behaviour": "bun scripts/v8.ts scripts/check-direct-behaviour.ts",
    "translate-eh": "bun scripts/v8.ts scripts/check-translate-eh.ts",
    "optimize-corpus": "bun scripts/v8.ts scripts/check-optimize-corpus.ts",
    "spec-behaviour": "bun scripts/v8.ts scripts/check-spec-behaviour.ts",
    "lowering": "bun scripts/check-lowering.ts",
    "hostile": "bun scripts/v8.ts scripts/check-hostile.ts",
    "browser": "bun scripts/check-browser.ts",
    "lts": "bun scripts/check-lts.ts",
    "lint": "biome lint --error-on-warnings && bun scripts/check-lint-canary.ts",
    "fmt": "dprint fmt",
    "fmt:check": "dprint check && bun scripts/check-fmt-canary.ts",
    "publish:dry": "bun x deno@2.9.6 publish --dry-run --allow-dirty",
    "comparison": "bun install --cwd comparison --frozen-lockfile && bun check -p comparison/tsconfig.json && bun scripts/v8.ts --v8=--test comparison/tests/asyncify_vs_wasm_opt.compare.ts comparison/tests/binaryen_interop.compare.ts comparison/tests/upstream_wasm_opt.compare.ts",
    "browsers": "bun scripts/check-browsers.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@std/assert": "npm:@jsr/std__assert@1.0.19",
    "@std/expect": "npm:@jsr/std__expect@1.0.19",
    "@types/node": "~22.18.0",
    "dprint": "0.57.4",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
