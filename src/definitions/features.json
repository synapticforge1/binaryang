  "rules": {
    "name": "The canonical name: the key of binaryang's `Features` (`allFeatures()`, `defaultFeatures()`).",
    "cli": "The spelling binaryang's CLIs accept, as `--enable-<cli>` / `--disable-<cli>`.",
    "defaultOn": "On in `defaultFeatures()` (wabt's tool defaults; not the same as 'in Wasm 3.0').",
    "implemented": "false: the flag exists and changes nothing (see `note`).",
    "testsuiteDirs": "Directories of the spec testsuite (relative to its root) whose suites need this feature. Empty: its tests are in the core suite, which runs with every feature on except as `onlyIn` / `offIn` say.",
    "onlyIn": "Absent: on everywhere. Present: ON only in these directories — it CHANGES core semantics, and the core suite (or another) asserts against the change.",
    "offIn": "Directories whose suite must run with this feature OFF — a snapshot written before the feature, which it relaxes.",
    "since": "The date the entry entered this list."
  },
