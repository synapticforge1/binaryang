        {
          "feature": "compactImports",
          "tier": "excluded",
          "refusedBy": [],
          "probes": 0,
          "note": "binaryang cannot read it (the flag is declared, not implemented); V8 needs --experimental-wasm-compact-imports."
        },
        {
          "feature": "wideArithmetic",
          "tier": "lowered",
          "pass": "WideArithmeticLowering",
          "refusedBy": [
            "chrome",
            "chromium",
            "deno",
            "edge",
            "firefox-esr",
            "node",
            "wasmedge",
            "wasmer",
            "wazero",
            "webkit"
          ],
          "probes": 4
        },
        {
          "feature": "customDescriptors",
          "tier": "excluded",
          "refusedBy": [
            "bun",
            "chrome",
            "chromium",
            "deno",
            "edge",
            "firefox",
            "firefox-esr",
            "firefox-release",
            "node",
            "wasmedge",
            "wasmer",
            "wasmtime",
            "wazero",
            "webkit"
          ],
          "probes": 4
        }
      ],
      "opcodes": [
        { "name": "br_on_non_null", "tier": "excluded", "refusedBy": ["wasmer"], "probes": 1 },
        {
          "name": "return_call_ref",
          "tier": "excluded",
          "refusedBy": ["wasmer"],
          "probes": 1,
          "note": "A tail call, and wasmer runs none; D1 gates it under functionReferences, the proposal that defines it (since D4 1.1.0, 2026-10-24; tailCall's before)."
        },
        {
          "name": "try",
          "tier": "lowered",
          "pass": "TranslateToExnref",
          "refusedBy": ["wasmedge", "wasmtime", "wazero"],
          "probes": 4,
