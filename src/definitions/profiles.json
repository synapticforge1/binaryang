          "name": "catch_all",
          "tier": "lowered",
          "pass": "TranslateToExnref",
          "refusedBy": ["wasmedge", "wasmtime", "wazero"],
          "probes": 1
        },
        {
          "name": "rethrow",
          "tier": "lowered",
          "pass": "TranslateToExnref",
          "refusedBy": ["wasmedge", "wasmtime", "wazero"],
          "probes": 1
        },
        {
          "name": "delegate",
          "tier": "lowered",
          "pass": "TranslateToExnref",
          "refusedBy": ["wasmedge", "wasmtime", "wazero"],
          "probes": 1
        }
      ]
    }
  ]
}
