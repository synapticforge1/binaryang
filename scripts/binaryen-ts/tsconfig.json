{
  // The root tsconfig.json with ONE flag relaxed (as a Deno workspace member did for `deno check`
  // until Bun migration B7): these diagnostic scripts index arrays freely. Checked by
  // `bun run check`.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": false
  },
  "include": ["./**/*.ts"],
  "exclude": []
}
