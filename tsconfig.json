{
  // The type check for Bun and Node (Bun migration B2, cmem/bun-migration.md): neither runtime
  // checks types, so `tsc` replaces `deno check`. The strictness flags are deno.json's, copied.
  //
  // Scope: the shipped code, and scripts/ since B4 converted it to node: builtins (2026-10-12).
  // scripts/binaryen-ts/ has its own tsconfig.json (it relaxes noUncheckedIndexedAccess, as its
  // deno.json member does); `bun run check` runs both. tests/ and comparison/ still use Deno
  // globals; each joins when B5 converts it, and `deno check` covers them until then.
  //
  // `types: ["node"]` and NOT bun: code must run on Bun and Node (owner, 2026-10-12), so a
  // Bun-only API has to fail this check. @types/node is pinned to 22.18, the published Node floor,
  // so an API newer than the floor fails it too.
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["main.ts", "src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["scripts/binaryen-ts/**"]
}
