{
  // THE type check (Bun migration B2, cmem/bun-migration.md): neither Bun nor Node checks types,
  // so `tsc` replaced `deno check`, alone since deno.json went (B7). The strictness flags were
  // deno.json's, copied.
  //
  // Scope: the shipped code, and scripts/ since B4 converted it to node: builtins (2026-10-12).
  // scripts/binaryen-ts/, tests/ and tests/binaryen-ts/ have their own tsconfig.json (the two
  // binaryen-ts trees relax noUncheckedIndexedAccess); `bun run check` runs all four. comparison/
  // is Deno-run and checked by `bun run comparison`, from comparison/deno.json.
  //
  // ⚠️ With no deno.json, `deno publish` reads THIS file's compilerOptions too, but not the
  // `@types/node` it names: shipped code must not rely on a type only @types/node declares
  // (main.ts's `import.meta.main`, B7).
  //
  // `types: ["node"]` and NOT bun: code must run on Bun and Node (owner, 2026-10-12), so a
  // Bun-only API has to fail this check. @types/node is pinned to 22.18, the published Node floor,
  // so an API newer than the floor fails it too.
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["main.ts", "src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["scripts/binaryen-ts/**"]
}
